<!--
  Edit the layout and styles for your server. Keep the panel/button IDs and
  {s:text} bindings: HidePlayers supplies per-player translations and selection.
  Compile this XML from your Workshop addon's content folder.
-->
<root>
    <styles>
        <include src="s2r://panorama/styles/custom_game/hideplayers/hideplayers.vcss_c" />
    </styles>
    <!-- The compiler assigns the outer panel's ID; keep this wrapper anonymous. -->
    <Panel class="HidePlayersScreen" hittest="false">
        <Panel id="hideplayers_root" class="HidePlayersWindow Dismissed" hittest="false">
            <Label id="hideplayers_title" class="Title" text="{s:text}" hittest="false" />
            <Label id="hideplayers_override" class="Override Dismissed" text="{s:text}" hittest="false" />
            <Panel class="ModeList" hittest="false">
                <Button id="hideplayers_off" class="Choice">
                    <Label id="hideplayers_off_label" text="{s:text}" hittest="false" />
                </Button>
                <Button id="hideplayers_all" class="Choice">
                    <Label id="hideplayers_all_label" text="{s:text}" hittest="false" />
                </Button>
                <Button id="hideplayers_team" class="Choice">
                    <Label id="hideplayers_team_label" text="{s:text}" hittest="false" />
                </Button>
                <Button id="hideplayers_enemy" class="Choice">
                    <Label id="hideplayers_enemy_label" text="{s:text}" hittest="false" />
                </Button>
            </Panel>
            <Label id="hideplayers_dead_label" class="SectionTitle" text="{s:text}" hittest="false" />
            <Panel class="DeadChoices" hittest="false">
                <Button id="hideplayers_dead_on" class="Choice HalfWidth HalfGap">
                    <Label id="hideplayers_dead_on_label" text="{s:text}" hittest="false" />
                </Button>
                <Button id="hideplayers_dead_off" class="Choice HalfWidth">
                    <Label id="hideplayers_dead_off_label" text="{s:text}" hittest="false" />
                </Button>
            </Panel>
            <Button id="hideplayers_close" class="CloseButton">
                <Label id="hideplayers_close_label" text="{s:text}" hittest="false" />
            </Button>
        </Panel>
    </Panel>
</root>
