<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>HidePlayers</AssemblyName>
    <OutputPath>$(MSBuildThisFileDirectory)build/</OutputPath>
    <PublishDir>$(OutputPath)publish/HidePlayers</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="SwiftlyS2.CS2" Version="*-*" ExcludeAssets="runtime" PrivateAssets="all" />
    <ProjectReference Include="HidePlayers.Contract/HidePlayers.Contract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="resources/translations/**/*;resources/panorama-addon/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="HidePlayers.Contract/**/*.cs" />
  </ItemGroup>

  <Target Name="ExportContract" AfterTargets="Publish" BeforeTargets="CreateZip">
    <Move SourceFiles="$(PublishDir)/HidePlayers.Contract.dll" DestinationFolder="$(PublishDir)/resources/exports/" />
  </Target>

  <Target Name="CreateZip" AfterTargets="Publish">
    <ItemGroup>
      <PublishFiles Include="$(PublishDir)**\*.*" />
    </ItemGroup>
    <RemoveDir Directories="$(IntermediateOutputPath)package" />
    <Copy SourceFiles="@(PublishFiles)" DestinationFiles="@(PublishFiles->'$(IntermediateOutputPath)package/$(AssemblyName)/%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(IntermediateOutputPath)package" DestinationFile="$(MSBuildThisFileDirectory)build/$(AssemblyName).zip" Overwrite="true" />
  </Target>

</Project>
